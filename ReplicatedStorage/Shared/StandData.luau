-- Basic M1 punch shared by every Stand. Numbers live in Config.Combat.
StandData.PunchMoveId = "Punch"

function StandData.Get(id: string?): Stand?
	if id == nil then
		return nil
	end
	return StandData.Stands[id]
end

function StandData.GetMove(id: string): Move?
	return StandData.Moves[id]
end

function StandData.Rollable(): { Stand }
	local list = {}
	for _, s in StandData.Stands do
		if s.Rollable then
			table.insert(list, s)
		end
	end
	table.sort(list, function(a, b)
		return a.Id < b.Id
	end)
	return list
end

-- Every form in a family, in evolution order.
function StandData.FamilyForms(family: string): { Stand }
	local list = {}
	for _, s in StandData.Stands do
		if s.Family == family then
			table.insert(list, s)
		end
	end
	table.sort(list, function(a, b)
		return a.Stage < b.Stage
	end)
	return list
end

function StandData.Grade(n: number): string
	return StandData.GradeLetters[math.clamp(n, 1, 6)]
end

return StandData
