local function look(
	body: Color3,
	accent: Color3,
	trim: Color3,
	eyes: Color3,
	build: string,
	head: string,
	extras: { string },
	material: Enum.Material?,
	size: number?
): Look
	return {
		Body = body,
		Accent = accent,
		Trim = trim,
		Eyes = eyes,
		Material = material or Enum.Material.SmoothPlastic,
		Build = build,
		Head = head,
		Extras = extras,
		Size = size or 1,
	}
end

local function req(kind: string, id: string, amount: number, text: string): Requirement
	return { Kind = kind, Id = id, Amount = amount, Text = text }
end

