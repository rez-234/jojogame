--!strict
-- Every Stand and every move. Stats use grades 1..6 (E, D, C, B, A, S).

export type Move = {
	Id: string,
	Name: string,
	Kind: string,
	Description: string,
	Damage: number,
	Cooldown: number,
	Range: number?,
	Radius: number?,
	Width: number?,
	Hits: number?,
	Interval: number?,
	Duration: number?,
	Speed: number?,
	Count: number?,
	Spread: number?,
	Windup: number?,
	Knockback: number?,
	Stun: number?,
	GuardBreak: boolean?,
	Unblockable: boolean?,
	Heal: number?,
	Distance: number?,
	Homing: number?,
	Delay: number?,
	Effect: string?,
	EffectPower: number?,
	EffectDuration: number?,
	Shape: string?,
	Color: Color3,
}

export type Requirement = {
	Kind: string, -- "Item" or "Counter"
	Id: string,
	Amount: number,
	Text: string,
}

export type Evolution = {
	Next: string,
	Level: number,
	Requirements: { Requirement },
}

export type Look = {
	Body: Color3,
	Accent: Color3,
	Trim: Color3,
	Eyes: Color3,
	Material: Enum.Material,
	Build: string, -- "Muscular", "Slim", "Small", "Creature", "Raptor", "Bird"
	Head: string, -- "Plain", "Helmet", "Bird", "Mask", "Horned", "Crown", "Hood", "Visor", "Void"
	Extras: { string },
	Size: number,
}

export type Stand = {
	Id: string,
	Name: string,
	Part: number,
	Rarity: string,
	Family: string,
	Stage: number, -- 1 for base form, 2+ for evolutions
	Rollable: boolean,
	Stats: { Power: number, Speed: number, Range: number, Durability: number, Precision: number },
	Moves: { string },
	PunchColor: Color3,
	Evolution: Evolution?,
	Look: Look,
	Description: string,
}

local StandData = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

