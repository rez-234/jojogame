--!strict
-- Enemy archetypes, race rivals and stage bosses.

local StandData = require(script.Parent.StandData)

export type Outfit = {
	Skin: Color3,
	Shirt: Color3,
	Pants: Color3,
	Hat: string?, -- "Cowboy", "Bowler", "Bandana", "Top", "None"
	HatColor: Color3?,
	Scarf: Color3?,
}

export type Drop = {
	Item: string?,
	Skin: string?,
	Horse: string?,
	Chance: number,
	Amount: number?,
}

export type Archetype = {
	Id: string,
	Name: string,
	Health: number,
	Damage: number,
	WalkSpeed: number,
	Moves: { string },
	Stand: string?, -- Stand id used for the visible Stand
	RandomStand: boolean?,
	Mounted: boolean?,
	Ranged: boolean?,
	Outfits: { Outfit },
	Cash: { number },
	XPMult: number,
	Drops: { Drop },
	Weight: number,
	MinStage: number,
}

export type Phase = {
	HealthFraction: number, -- phase starts when health falls below this
	Moves: { string },
	SpeedMult: number,
	SummonAdds: number,
	Line: string,
}

export type Boss = {
	Id: string,
	Name: string,
	StandName: string,
	Stage: number,
	Level: number,
	Health: number,
	Damage: number,
	WalkSpeed: number,
	Stand: string?,
	Look: StandData.Look?,
	Outfit: Outfit,
	Phases: { Phase },
	AddArchetype: string,
	Cash: number,
	XP: number,
	Drops: { Drop },
}

export type Rival = {
	Name: string,
	Stand: string?,
	Moves: { string },
	Outfit: Outfit,
	SpeedMult: number,
	Breed: string,
}

